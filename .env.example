# =============================================================================
# ZENTRAVO BMS - Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth v5 / Auth.js)
# -----------------------------------------------------------------------------
AUTH_SECRET="your-auth-secret-min-32-chars-change-this"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# CLOUDINARY (File / Image Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# -----------------------------------------------------------------------------
# OTP / SMS PROVIDER
# Provider options: "twilio" | "dialog" | "mobitel" | "console" (dev)
# -----------------------------------------------------------------------------
OTP_PROVIDER="console"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Twilio (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# Dialog SMS (if OTP_PROVIDER=dialog)
DIALOG_SMS_API_KEY="your-dialog-api-key"
DIALOG_SMS_SENDER_ID="ZENTRAVO"

# -----------------------------------------------------------------------------
# EMAIL PROVIDER
# Provider options: "resend" | "smtp" | "console" (dev)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@zentravo.lk"

# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY="re_your_resend_api_key"

# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# -----------------------------------------------------------------------------
# WHATSAPP
# Provider options: "meta" | "twilio" | "console" (dev)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER="console"

# Meta WhatsApp Business API
WHATSAPP_META_ACCESS_TOKEN="your-meta-access-token"
WHATSAPP_META_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_META_VERIFY_TOKEN="your-webhook-verify-token"

# -----------------------------------------------------------------------------
# AI ASSISTANT
# Provider options: "openai" | "gemini" | "anthropic"
# -----------------------------------------------------------------------------
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS=2000

# -----------------------------------------------------------------------------
# PAYMENT PROVIDERS
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER="cod"

# PayHere (Sri Lanka)
PAYHERE_MERCHANT_ID="your-payhere-merchant-id"
PAYHERE_MERCHANT_SECRET="your-payhere-secret"
PAYHERE_SANDBOX=true

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Zentravo BMS"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_CURRENCY="LKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_COUNTRY="LK"
NEXT_PUBLIC_TIMEZONE="Asia/Colombo"

# -----------------------------------------------------------------------------
# SUPER ADMIN
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@zentravo.lk"
SUPER_ADMIN_SETUP_KEY="change-this-super-secret-setup-key"

# -----------------------------------------------------------------------------
# CRON / BACKGROUND JOBS
# -----------------------------------------------------------------------------
CRON_SECRET="your-cron-secret-key"

# -----------------------------------------------------------------------------
# REDIS / CACHE (optional, for rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
KV_REST_API_URL="your-vercel-kv-url"
KV_REST_API_TOKEN="your-vercel-kv-token"

# -----------------------------------------------------------------------------
# FEATURES
# -----------------------------------------------------------------------------
ENABLE_AI_ASSISTANT=true
ENABLE_ECOMMERCE=true
ENABLE_LOYALTY=true
ENABLE_MARKETING=true
ENABLE_WHATSAPP=false
ENABLE_OFFLINE_POS=true
NODE_ENV="development"
